# Copy this file to .env for local development.
# Never commit .env or put real secrets in profile.yaml.

# Provider selection (non-secret)
LLM_PROVIDER=structured-output-provider
TTS_PROVIDER=tts-provider
AVATAR_PROVIDER=optional-avatar-provider
PUBLISHER_PROVIDER=manual-review
ANALYTICS_PROVIDER=manual-snapshots
STORAGE_PROVIDER=local

# Required only when the corresponding adapter is enabled
LLM_API_KEY=
TTS_API_KEY=
AVATAR_API_KEY=
PUBLISHER_API_KEY=
ANALYTICS_API_KEY=

# Optional media-storage configuration for API publishing
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# Local workflow settings
WORKSPACE_DIR=./jobs
REVIEW_DIR=./review
PROFILE_PATH=./profile.yaml
